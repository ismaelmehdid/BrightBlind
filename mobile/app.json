{
  "expo": {
    "name": "BrightBlind",
    "slug": "brightblind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andriidrok.secondvision",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLName": "com.andriidrok.secondvision",
            "CFBundleURLSchemes": [
              "secondvision"
            ]
          }
        ],
        "MWDAT": {
          "AppLinkURLScheme": "secondvision://",
          "MetaAppID": "",
          "ClientToken": "",
          "TeamID": "",
          "Analytics": {
            "OptOut": true
          },
          "CrashReporting": {
            "OptOut": true
          }
        },
        "UIBackgroundModes": [
          "audio",
          "processing",
          "bluetooth-central",
          "bluetooth-peripheral",
          "external-accessory"
        ],
        "UISupportedExternalAccessoryProtocols": [
          "com.meta.ar.wearable"
        ],
        "NSBluetoothAlwaysUsageDescription": "Connects to your Ray-Ban Meta glasses and your Vexo band.",
        "NSBluetoothPeripheralUsageDescription": "Connects to your Ray-Ban Meta glasses.",
        "NSLocalNetworkUsageDescription": "Needed to stream video from the glasses over Wi-Fi.",
        "NSBonjourServices": [
          "_bonjour._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Used only by the glasses SDK mock device when no glasses are paired.",
        "UIRequiredDeviceCapabilities": [
          "arm64"
        ]
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.andriidrok.secondvision"
        ],
        "com.apple.developer.networking.HotspotConfiguration": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.2"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "BrightBlind connects to your Vexo band."
        }
      ]
    ]
  }
}
